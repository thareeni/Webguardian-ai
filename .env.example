# Phase 1 doesn't require any of these yet - they're wired up ahead of Phase 2
# (RAG Agent, Fix Agent) so the .env story doesn't change later.

# LLM provider for Root Cause / Fix / RAG agents (Phase 2+)
ANTHROPIC_API_KEY=

# Vector DB (Phase 2+)
CHROMA_DB_PATH=./storage/chroma

# Database (Phase 3 - swaps out the in-memory SCANS dict)
DATABASE_URL=postgresql://webguardian:webguardian@localhost:5432/webguardian

# App
BACKEND_PORT=8000
FRONTEND_PORT=5173
